package cursor.config;

/**
 * The built-in cursor styles supported by the library.
 */
enum CursorStyle
{
	/**
	 * Standard arrow cursor.
	 */
	Default;
	
	/**
	 * Pointer cursor, commonly used for clickable elements.
	 */
	Pointer;
	
	/**
	 * Grab cursor, commonly used to indicate a draggable area.
	 */
	Grab;
	
	/**
	 * Crosshair cursor.
	 */
	Cross;
	
	/**
	 * Text insertion cursor.
	 */
	Text;
	
	/**
	 * Busy or loading cursor.
	 */
	Loading;
}
